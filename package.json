{
  "name": "dsh-whale-aqua-theme",
  "version": "2.3.0",
  "description": "鲸蓝戏水：DeepSeek Harness 的 macOS 风格皮肤 + 水中鲸鱼动态背景 + 点阵鲸鱼发送按钮（可安装 DSH 插件包，适配 DSH 0.2.x / Desktop 版）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dataizu/dsh-whale-aqua-theme.git"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "skin",
    "desktop"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "icon.svg",
    "locale/*.json"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "icon": "./icon.svg"
}
